    "BastionInstance": {
      "Type" : "AWS::EC2::Instance",
      "Properties" : {
        "BlockDeviceMappings" : [ {
          "DeviceName" : "/dev/sda1",
          "Ebs" : {
            "DeleteOnTermination" : true,
            "VolumeSize" : { "Fn::FindInMap": [ "InstanceConfig", "Storage", "ValueByGb" ] }
          }
        } ],
        "DisableApiTermination" : false,
        "IamInstanceProfile" : { "Ref": "BastionInstanceProfile" },
        "ImageId" : { "Ref": "BastionInstanceAMI" },
        "InstanceInitiatedShutdownBehavior" : "stop",
        "InstanceType" : { "Ref": "BastionInstanceType" },
        "KeyName" : { "Ref": "EC2KeyPair" },
        "Monitoring" : true,
        "NetworkInterfaces" : [ {
          "Description" : "Mastodon Network Interface.",
          "DeviceIndex" : "0",
          "NetworkInterfaceId" : { "Ref": "BastionInstanceNetworkIF" }
        } ],
        "Tags" : [
          { "Key": "Name", "Value": { "Fn::Sub": "${AWS::StackName}-Bastion" } },
          { "Key": { "Ref": "Tag1Key" }, "Value": { "Ref": "Tag1Value"} }
        ],
        "UserData": {"Fn::Base64": {"Fn::Join": ["", [
          "#!/bin/bash -xe\n",
          "# ********** Install packages for cloud formation **********\n",
          "apt-get update \n",
          "apt-get -y install python-pip \n",
          "pip install --upgrade pip \n",
          "pip install https://s3.amazonaws.com/cloudformation-examples/aws-cfn-bootstrap-latest.tar.gz \n",
          "cp -a /usr/local/bin/cfn-hup /etc/init.d/cfn-hup\n",
          "chmod u+x /etc/init.d/cfn-hup\n",
          "update-rc.d cfn-hup defaults \n",

          "# ********** Install required packages **********\n",
          "apt-get install -y ",
          "  imagemagick ffmpeg libpq-dev libxml2-dev libxslt1-dev nodejs file git",
          "   curl gcc g++ ruby ruby-dev make postgresql-client nginx awscli\n",
          "curl -sL https://deb.nodesource.com/setup_4.x | bash - \n",
          "apt-get install -y nodejs \n",
          "npm install -g yarn \n",
          "gem install bundler \n",

          "# ********** Add user **********\n",
          "useradd -d /home/mastodon --create-home --user-group mastodon\n",

          "# ********** Build Mastodon **********\n",
          "cd /home/mastodon \n",
          "git clone https://github.com/tootsuite/mastodon.git live \n",
          "cd live \n",
          "git checkout $(git tag | tail -n 1) \n",

          "bundle install --deployment --without development test \n",
          "yarn install --pure-lockfile \n",

          "# ********** Setup Mastodon **********\n",
          "cat << 'EOSEOSEOS' > .env.production\n",
          "# GENERATED BY CLOUD FORMATION TEMPLATE\n",
          "# Redis\n",
          "REDIS_HOST=", { "Fn::GetAtt": [ "ElastiCacheCluster", "RedisEndpoint.Address" ] }, "\n",
          "REDIS_PORT=", { "Fn::GetAtt": [ "ElastiCacheCluster", "RedisEndpoint.Port" ] }, "\n",
          "# Database\n",
          "DB_HOST=", { "Fn::GetAtt": [ "RDSInstance", "Endpoint.Address" ] }, "\n",
          "DB_USER=", { "Ref": "DBMasterUsername" }, "\n",
          "DB_NAME=", { "Ref": "DBName" }, "\n",
          "DB_PASS=", { "Ref": "DBMasterUserPassword" }, "\n",
          "DB_PORT=", { "Fn::GetAtt": [ "RDSInstance", "Endpoint.Port" ] }, "\n",
          "# Domain\n",
          "LOCAL_DOMAIN=", { "Ref": "MastodonFQDN" }, "\n",
          "LOCAL_HTTPS=true\n",
          "# Mail\n",
          "SMTP_SERVER=", { "Ref": "SMTPHostName" }, "\n",
          "SMTP_PORT=", { "Ref": "SMTPHostPort" }, "\n",
          "SMTP_LOGIN=", { "Ref": "SMTPUserName" }, "\n",
          "SMTP_PASSWORD=", { "Ref": "SMTPPassword" }, "\n",
          "SMTP_FROM_ADDRESS=", { "Ref": "SMTPSenderAddress" }, "\n",
          "# Aws\n",
          "S3_ENABLED=true\n",
          "S3_BUCKET=", { "Ref": "ContentsS3Bucket" }, "\n",
          "AWS_ACCESS_KEY_ID=", { "Ref": "ContentsAWSAccessKey" }, "\n",
          "AWS_SECRET_ACCESS_KEY=", { "Ref": "ContentsAWSAccessSecret" }, "\n",
          "S3_REGION=", { "Ref": "AWS::Region" }, "\n",
          "S3_PROTOCOL=https\n",
          "S3_HOSTNAME=", { "Fn::If": [ "IsVirginia",
            "s3.amazonaws.com",
            { "Fn::Join": [ "", [ "s3-", { "Ref": "AWS::Region" }, ".amazonaws.com" ] ] } ] }, "\n",
          "EOSEOSEOS\n\n",
          "echo \"PAPERCLIP_SECRET=`rake secret`\" >> .env.production\n",
          "echo \"SECRET_KEY_BASE=`rake secret`\" >> .env.production\n",
          "echo \"OTP_SECRET=`rake secret`\" >> .env.production\n",

          "RAILS_ENV=production bundle exec rails db:setup\n",
          "RAILS_ENV=production bundle exec rails assets:precompile\n",

          "cd .. \n",

          "tar cfz ", { "Ref": "PackageName" }, " live \n",
          { "Fn::Sub": "aws s3 cp ${PackageName} s3://${PackageS3Bucket}/${PackageS3Prefix}/${PackageName} \n" },

          "# ********** The End **********\n"
        ] ] } }
      }
    },



