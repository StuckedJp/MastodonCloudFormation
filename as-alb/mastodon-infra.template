      "Properties" : {
        "RouteTableId" : { "Ref": "VPCRouteTable" },
        "SubnetId" : { "Ref": "PublicSubnet2" }
      }
    },


    "PrivateSubnetNetworkAcl": {
      "Type" : "AWS::EC2::NetworkAcl",
      "Properties" : {
        "Tags" : [
          { "Key": { "Ref": "Tag1Key" }, "Value": { "Ref": "Tag1Value"} }
        ],
