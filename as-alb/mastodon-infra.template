    "SecurityGroupBastionInstance": {
      "Type" : "AWS::EC2::SecurityGroup",
      "Properties" : {
        "GroupDescription" : "Security Group for bastion Instance Host",
        "Tags" :  [
          { "Key": { "Ref": "Tag1Key" }, "Value": { "Ref": "Tag1Value"} }
