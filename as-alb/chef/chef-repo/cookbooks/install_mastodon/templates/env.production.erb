LOCAL_DOMAIN=<%= @server_data['federation']['local_domain'] %>

# Database
DB_HOST=<%= @server_data['database']['db_host'] %>
DB_USER=<%= @server_data['database']['db_user'] %>
DB_NAME=<%= @server_data['database']['db_name'] %>
DB_PASS=<%= @server_data['database']['db_pass'] %>
DB_PORT=<%= @server_data['database']['db_port'] %>

# Redis
REDIS_HOST=<%= @server_data['cache']['redis_host'] %>
REDIS_PORT=<%= @server_data['cache']['redis_port'] %>

# Mail
SMTP_SERVER=<%= @server_data['mail']['smtp_server'] %>
SMTP_PORT=<%= @server_data['mail']['smtp_port'] %>
SMTP_LOGIN=<%= @server_data['mail']['smtp_login'] %>
SMTP_PASSWORD=<%= @server_data['mail']['smtp_password'] %>
SMTP_FROM_ADDRESS=<%= @server_data['mail']['smtp_from_address'] %>

# AWS
S3_ENABLED=true
S3_BUCKET=<%= @server_data['s3']['s3_bucket'] %>
AWS_ACCESS_KEY_ID=<%= @server_data['s3']['aws_access_key_id'] %>
AWS_SECRET_ACCESS_KEY=<%= @server_data['s3']['aws_secret_access_key'] %>
S3_REGION=<%= @server_data['s3']['s3_region'] %>
S3_PROTOCOL=https
S3_HOSTNAME=<%= @server_data['s3']['s3_hostname'] %>

