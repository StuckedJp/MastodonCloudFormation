{
  "name": "mastodon",
  "version": "0.1.0",
  "bin": {
    "mastodon-infra": "bin/mastodon-infra.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
